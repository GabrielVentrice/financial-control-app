# Bkper (fonte das transacoes)
# Id do book — GET https://api.bkper.app/v5/books lista os seus
NUXT_BKPER_BOOK_ID=
# Refresh token do `bkper auth login` (fica em ~/.config/bkper/.bkper-credentials.json)
NUXT_BKPER_REFRESH_TOKEN=
# Cliente OAuth que emitiu o refresh token (o do proprio CLI do Bkper)
NUXT_BKPER_CLIENT_ID=
NUXT_BKPER_CLIENT_SECRET=
# Opcional: chave de API do Bkper, so para cota dedicada
NUXT_BKPER_API_KEY=

# Google Sheets — usado APENAS pelas telas de orcamento (abas Budgets_v2 /
# Budget_Templates). As transacoes NAO vem daqui, vem do Bkper.
NUXT_PUBLIC_GOOGLE_SPREADSHEET_ID=
NUXT_GOOGLE_CLIENT_EMAIL=
# Chave privada da service account (inclua com as quebras de linha \n).
# NUNCA commite o valor real — este arquivo ja vazou uma chave uma vez.
NUXT_GOOGLE_PRIVATE_KEY=

# PostgreSQL (Neon) — guarda apenas a tabela debt_plans (ancora do cheque
# especial). Sem ela a tela de divida nao funciona.
DATABASE_URL=
