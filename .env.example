# Bkper (fonte das transacoes)
# Id do book — GET https://api.bkper.app/v5/books lista os seus
NUXT_BKPER_BOOK_ID=
# Refresh token do `bkper auth login` (fica em ~/.config/bkper/.bkper-credentials.json)
NUXT_BKPER_REFRESH_TOKEN=
# Cliente OAuth que emitiu o refresh token (o do proprio CLI do Bkper)
NUXT_BKPER_CLIENT_ID=
NUXT_BKPER_CLIENT_SECRET=
# Opcional: chave de API do Bkper, so para cota dedicada
NUXT_BKPER_API_KEY=

# PostgreSQL (Neon) — guarda o estado que o livro nao contem: debt_plans
# (ancora do cheque especial) e budget_targets (meta mensal por categoria).
# Sem ela a tela principal e a de divida nao funcionam.
DATABASE_URL=
